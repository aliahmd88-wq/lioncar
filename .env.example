# Lion Car storefront — copy to .env.local for development, or set these in Coolify.

# WordPress backend (shared with the old ALI FLEET install). WPGraphQL endpoint
# and the WooCommerce origin that owns /checkout. The mu-plugin on a-f.site must
# list the storefront origin (https://lioncar.co.il) in ALIFLEET_ALLOWED_ORIGINS.
WORDPRESS_GRAPHQL_ENDPOINT=https://a-f.site/graphql
WORDPRESS_STORE_URL=https://a-f.site

# Public origin of this storefront: canonical URLs, sitemap, robots, JSON-LD and
# the WooCommerce checkout handoff all derive from it.
NEXT_PUBLIC_SITE_URL=https://lioncar.co.il
